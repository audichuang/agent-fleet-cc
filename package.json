{
  "name": "agent-fleet-cc",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "One marketplace for delegation plugins: codex, antigravity (agy), cc (Claude Code via profiles)",
  "engines": { "node": ">=22.3" },
  "scripts": {
    "test": "npm run test:structure && npm run test:shared && npm run test:cc && npm run test:antigravity && npm run test:codex && npm run test:grok && npm run test:fleet && npm run test:e2e",
    "test:structure": "node --test tests/*.test.mjs",
    "test:shared": "node --test \"tests/shared/*.test.mjs\" \"tests/shared/conformance/*.test.mjs\"",
    "test:cc": "node --test tests/cc/*.test.mjs",
    "test:e2e": "node --test tests/cc/e2e-cli.test.mjs tests/codex/e2e-cli.test.mjs tests/antigravity/e2e-cli.test.mjs tests/fleet/e2e-cli.test.mjs",
    "test:antigravity": "node --test --experimental-test-module-mocks tests/antigravity/*.test.mjs",
    "test:codex": "node --test tests/codex/*.test.mjs",
    "test:grok": "node --test tests/grok/*.test.mjs",
    "test:codex:smoke": "node --test tests/codex/worktree-guard-foreign-broker.smoke.mjs",
    "test:fleet": "node --test \"tests/fleet/*.test.mjs\"",
    "bump-version": "node scripts/bump-version.mjs",
    "check-version": "node scripts/bump-version.mjs --check",
    "sync-shared": "node scripts/sync-shared.mjs",
    "use-local": "node .claude/skills/local-install-test/scripts/use-local-version.mjs",
    "prebuild:codex": "mkdir -p plugins/codex/.generated/app-server-types && codex app-server generate-ts --out plugins/codex/.generated/app-server-types",
    "build:codex": "tsc -p tsconfig.app-server.json"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
}
